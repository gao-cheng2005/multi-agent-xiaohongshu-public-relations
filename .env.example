# 真实抓取：调用 OpenCLI 复用 Chrome 登录态抓取小红书（当前唯一采集模式）
OPENCLI_BIN=opencli

# 大模型配置（硅基流动 SiliconFlow），用于舆情情感分析和应对方案生成
# API Key 为公司固定密钥，前端无需（也无法）填写；改这里后需重启后端
SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_DEFAULT_MODEL=Qwen/Qwen2.5-7B-Instruct

# 情感分析模式：auto=有 key 用 LLM 否则规则；llm=强制 LLM；rule=强制规则
SENTIMENT_MODE=auto

# 大模型请求超时时间（秒）
LLM_TIMEOUT=60

# MySQL 业务数据库
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=yuqing_pr
CHECKPOINT_DATABASE=yuqing_pr_langgraph

# ChromaDB
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8001
CHROMA_PERSIST_DIR=data/chroma

# RAG 增强（文案话术库）：检索增强生成，默认关闭，失败静默降级
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_TIMEOUT=5
RAG_ENABLED=false
RAG_TOP_K=3
